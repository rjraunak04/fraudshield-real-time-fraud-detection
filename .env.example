# FraudShield environment template.
# Never commit real credentials or generated model artifacts.

FRAUDSHIELD_ENV=development
FRAUDSHIELD_DATABASE_URL=postgresql+psycopg://fraudshield:change-me@postgres:5432/fraudshield
FRAUDSHIELD_REDIS_URL=redis://redis:6379/0
FRAUDSHIELD_REDIS_NAMESPACE=fraudshield
FRAUDSHIELD_MODEL_ARTIFACT=/app/artifacts/fraud_model.pkl
FRAUDSHIELD_CALIBRATOR_ARTIFACT=/app/artifacts/fraud_calibrator.pkl
